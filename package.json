{
  "name": "branchReviewer",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "macos": "npx react-native-macos run-macos",
    "lint": "eslint .",
    "start": "npx react-native-macos start",
    "test": "jest",
    "bundle:macos": "npx react-native-macos bundle --entry-file index.js --platform macos --dev false --bundle-output macos/main.jsbundle --assets-dest macos",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-native": "npm:react-native-macos@^0.78.6",
    "react-native-macos": "^0.78.6"
  },
  "devDependencies": {
    "@babel/core": "^7.26.11",
    "@babel/preset-env": "^7.26.11",
    "@react-native-community/cli": "^20.0.2",
    "@react-native/babel-preset": "^0.83.1",
    "@react-native/eslint-config": "^0.83.1",
    "@react-native/typescript-config": "^0.83.1",
    "@react-native/metro-config": "^0.83.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.7",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.7.4",
    "react-test-renderer": "^19.2.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,js}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
